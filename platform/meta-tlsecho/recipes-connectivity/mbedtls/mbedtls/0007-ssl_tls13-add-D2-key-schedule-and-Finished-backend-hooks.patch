From 572d563a021c47ebf560177ec5bcc2b01d357188 Mon Sep 17 00:00:00 2001
From: Florian Foerster <florian.foerster@tha.de>
Date: Thu, 16 Jul 2026 15:10:35 +0000
Subject: [PATCH] ssl_tls13: add D2 key schedule and Finished backend hooks

Upstream-Status: Inappropriate [local experimental TLS 1.3 TrustZone for Arm Cortex-A research patch]
---
 include/mbedtls/ssl.h    |  80 ++++++++-
 library/ssl_tls.c        |  13 +-
 library/ssl_tls13_keys.c | 377 ++++++++++++++++++++++++++++++++++++++-
 3 files changed, 457 insertions(+), 13 deletions(-)

diff --git a/include/mbedtls/ssl.h b/include/mbedtls/ssl.h
index 0e36a8c..84a068d 100644
--- a/include/mbedtls/ssl.h
+++ b/include/mbedtls/ssl.h
@@ -1153,7 +1153,7 @@ typedef void mbedtls_ssl_async_cancel_t(mbedtls_ssl_context *ssl);
 #if defined(MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND)
 
 /** Local TLS 1.3 cryptographic-backend API revision. */
-#define MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_API_VERSION 2u
+#define MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_API_VERSION 3u
 
 /** The backend provides per-connection lifecycle callbacks. */
 #define MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_CONNECTION_LIFECYCLE 0x00000001u
@@ -1164,11 +1164,19 @@ typedef void mbedtls_ssl_async_cancel_t(mbedtls_ssl_context *ssl);
 /** The backend can protect TLS 1.3 records using imported traffic keys. */
 #define MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_RECORD_AEAD          0x00000004u
 
-/** Capabilities known by API revision 2. */
+/** The backend can derive TLS 1.3 full-handshake secrets and transforms. */
+#define MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_KEY_SCHEDULE         0x00000008u
+
+/** The backend can calculate TLS 1.3 Finished verify_data. */
+#define MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_FINISHED             0x00000010u
+
+/** Capabilities known by API revision 3. */
 #define MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_MASK \
     (MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_CONNECTION_LIFECYCLE | \
      MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_TRANSFORM_LIFECYCLE  | \
-     MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_RECORD_AEAD)
+     MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_RECORD_AEAD          | \
+     MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_KEY_SCHEDULE         | \
+     MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_FINISHED)
 
 /**
  * \brief Initialize backend state for one SSL connection.
@@ -1220,9 +1228,9 @@ typedef void mbedtls_ssl_tls13_crypto_backend_transform_free_t(
 /**
  * \brief Import software-derived TLS 1.3 record keys into the backend.
  *
- * API revision 2 uses this callback as an engineering step towards final
- * Scenario D: Mbed TLS still derives the traffic keys in the REE, then the
- * backend imports them and owns record protection for this transform.
+ * API revision 2 uses this callback for D1 temporary-key import.
+ * API revision 3 keeps it for compatibility, while D2-capable backends can
+ * create transforms directly from backend-derived secrets.
  */
 typedef int mbedtls_ssl_tls13_crypto_backend_transform_import_t(
     mbedtls_ssl_context *ssl,
@@ -1273,11 +1281,61 @@ typedef int mbedtls_ssl_tls13_crypto_backend_record_open_t(
     size_t plaintext_size,
     size_t *plaintext_len);
 
+/**
+ * \brief Derive TLS 1.3 full-handshake secrets and create a backend-owned
+ *        handshake record transform.
+ *
+ * API revision 3 uses this callback as Scenario D2: Mbed TLS still computes
+ * the ECDHE shared secret in the REE, but imports that shared secret into the
+ * backend. The backend derives handshake/master secrets, Finished keys,
+ * traffic keys and IVs, and returns an opaque transform handle.
+ */
+typedef int mbedtls_ssl_tls13_crypto_backend_handshake_keys_t(
+    mbedtls_ssl_context *ssl,
+    void *config_data,
+    void *connection_data,
+    uint16_t ciphersuite,
+    uint16_t tls_version,
+    const unsigned char *shared_secret,
+    size_t shared_secret_len,
+    const unsigned char *transcript,
+    size_t transcript_len,
+    void **transform_data);
+
+/**
+ * \brief Derive TLS 1.3 application secrets and create a backend-owned
+ *        application record transform.
+ */
+typedef int mbedtls_ssl_tls13_crypto_backend_application_keys_t(
+    mbedtls_ssl_context *ssl,
+    void *config_data,
+    void *connection_data,
+    uint16_t ciphersuite,
+    uint16_t tls_version,
+    const unsigned char *transcript,
+    size_t transcript_len,
+    void **transform_data);
+
+/**
+ * \brief Calculate TLS 1.3 Finished verify_data from backend-owned
+ *        handshake traffic secrets.
+ */
+typedef int mbedtls_ssl_tls13_crypto_backend_finished_t(
+    mbedtls_ssl_context *ssl,
+    void *config_data,
+    void *connection_data,
+    int from,
+    const unsigned char *transcript,
+    size_t transcript_len,
+    unsigned char *verify_data,
+    size_t verify_data_size,
+    size_t *verify_data_len);
+
 /**
  * \brief Application-provided TLS 1.3 cryptographic backend.
  *
- * API revision 2 extends lifecycle support with temporary record-AEAD import and record-protection callbacks. Later local L1
- * patches append typed cryptographic callbacks to this structure. A backend
+ * API revision 3 extends lifecycle and record-AEAD support with D2
+ * key-schedule and Finished callbacks. A backend
  * must initialize every field and set \p struct_size to sizeof of this
  * structure as compiled by the application.
  */
@@ -1298,6 +1356,12 @@ typedef struct mbedtls_ssl_tls13_crypto_backend {
         *record_seal;
     mbedtls_ssl_tls13_crypto_backend_record_open_t
         *record_open;
+    mbedtls_ssl_tls13_crypto_backend_handshake_keys_t
+        *handshake_keys;
+    mbedtls_ssl_tls13_crypto_backend_application_keys_t
+        *application_keys;
+    mbedtls_ssl_tls13_crypto_backend_finished_t
+        *finished;
 } mbedtls_ssl_tls13_crypto_backend;
 
 #endif /* MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND */
diff --git a/library/ssl_tls.c b/library/ssl_tls.c
index c8a5f44..d14385b 100644
--- a/library/ssl_tls.c
+++ b/library/ssl_tls.c
@@ -3215,7 +3215,18 @@ int mbedtls_ssl_conf_tls13_crypto_backend(
             MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_TRANSFORM_LIFECYCLE) == 0 ||
           backend->transform_import == NULL ||
           backend->record_seal == NULL ||
-          backend->record_open == NULL))) {
+          backend->record_open == NULL)) ||
+        ((capabilities &
+            MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_KEY_SCHEDULE) != 0 &&
+         ((capabilities &
+            MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_RECORD_AEAD) == 0 ||
+          backend->handshake_keys == NULL ||
+          backend->application_keys == NULL)) ||
+        ((capabilities &
+            MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_FINISHED) != 0 &&
+         ((capabilities &
+            MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_KEY_SCHEDULE) == 0 ||
+          backend->finished == NULL))) {
         return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
     }
 
diff --git a/library/ssl_tls13_keys.c b/library/ssl_tls13_keys.c
index e6758b7..4d51c12 100644
--- a/library/ssl_tls13_keys.c
+++ b/library/ssl_tls13_keys.c
@@ -695,6 +695,11 @@ static int ssl_tls13_key_schedule_stage_application(mbedtls_ssl_context *ssl)
     return 0;
 }
 
+#if defined(MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND)
+static int ssl_tls13_backend_has_capability(const mbedtls_ssl_context *ssl,
+                                            uint32_t capability);
+#endif /* MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND */
+
 MBEDTLS_CHECK_RETURN_CRITICAL
 static int ssl_tls13_calc_finished_core(psa_algorithm_t hash_alg,
                                         unsigned char const *base_key,
@@ -793,6 +798,41 @@ int mbedtls_ssl_tls13_calculate_verify_data(mbedtls_ssl_context *ssl,
 
     MBEDTLS_SSL_DEBUG_MSG(2, ("=> mbedtls_ssl_tls13_calculate_verify_data"));
 
+#if defined(MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND)
+    if (ssl_tls13_backend_has_capability(
+            ssl, MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_FINISHED) != 0) {
+        ret = mbedtls_ssl_get_handshake_transcript(ssl, md_type,
+                                                   transcript,
+                                                   sizeof(transcript),
+                                                   &transcript_len);
+        if (ret != 0) {
+            MBEDTLS_SSL_DEBUG_RET(1,
+                                  "mbedtls_ssl_get_handshake_transcript", ret);
+            goto exit;
+        }
+        MBEDTLS_SSL_DEBUG_BUF(4, "handshake hash", transcript, transcript_len);
+
+        ret = ssl->conf->tls13_crypto_backend->finished(
+            ssl,
+            ssl->conf->p_tls13_crypto_backend,
+            mbedtls_ssl_get_tls13_crypto_backend_connection_data(ssl),
+            from,
+            transcript, transcript_len,
+            dst, dst_len, actual_len);
+        if (ret != 0) {
+            MBEDTLS_SSL_DEBUG_RET(1,
+                                  "TLS 1.3 backend Finished", ret);
+            goto exit;
+        }
+
+        MBEDTLS_SSL_DEBUG_BUF(3, "verify_data for finished message", dst,
+                              *actual_len);
+        MBEDTLS_SSL_DEBUG_MSG(2,
+                              ("<= mbedtls_ssl_tls13_calculate_verify_data"));
+        goto exit;
+    }
+#endif /* MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND */
+
     if (from == MBEDTLS_SSL_IS_CLIENT) {
         base_key = tls13_hs_secrets->client_handshake_traffic_secret;
         base_key_len = sizeof(tls13_hs_secrets->client_handshake_traffic_secret);
@@ -825,8 +865,10 @@ int mbedtls_ssl_tls13_calculate_verify_data(mbedtls_ssl_context *ssl,
     MBEDTLS_SSL_DEBUG_MSG(2, ("<= mbedtls_ssl_tls13_calculate_verify_data"));
 
 exit:
-    /* Erase handshake secrets */
-    mbedtls_platform_zeroize(base_key, base_key_len);
+    /* Erase handshake secrets when the software path was used. */
+    if (base_key != NULL && base_key_len != 0) {
+        mbedtls_platform_zeroize(base_key, base_key_len);
+    }
     mbedtls_platform_zeroize(transcript, sizeof(transcript));
     return ret;
 }
@@ -1753,13 +1795,315 @@ cleanup:
     return ret;
 }
 
+
+#if defined(MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND)
+static int ssl_tls13_backend_has_capability(const mbedtls_ssl_context *ssl,
+                                            uint32_t capability)
+{
+    return ssl != NULL && ssl->conf != NULL &&
+           ssl->conf->tls13_crypto_backend != NULL &&
+           (ssl->conf->tls13_crypto_backend->capabilities & capability) != 0;
+}
+
+static int ssl_tls13_backend_setup_external_transform(
+    mbedtls_ssl_context *ssl,
+    mbedtls_ssl_transform *transform,
+    int ciphersuite,
+    void *transform_data)
+{
+    int ret;
+    const mbedtls_ssl_ciphersuite_t *ciphersuite_info;
+    size_t key_len = 0;
+    size_t iv_len = 0;
+
+    if (ssl == NULL || ssl->conf == NULL || transform == NULL ||
+        transform_data == NULL || ssl->conf->tls13_crypto_backend == NULL) {
+        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+    }
+
+    ciphersuite_info = mbedtls_ssl_ciphersuite_from_id(ciphersuite);
+    if (ciphersuite_info == NULL) {
+        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+    }
+
+    ret = ssl_tls13_get_cipher_key_info(ciphersuite_info, &key_len, &iv_len);
+    if (ret != 0) {
+        return ret;
+    }
+
+    if ((ciphersuite_info->flags & MBEDTLS_CIPHERSUITE_SHORT_TAG) != 0) {
+        transform->taglen = 8;
+    } else {
+        transform->taglen = 16;
+    }
+
+    transform->ivlen = iv_len;
+    transform->maclen = 0;
+    transform->fixed_ivlen = transform->ivlen;
+    transform->tls_version = MBEDTLS_SSL_VERSION_TLS1_3;
+    transform->minlen =
+        transform->taglen + MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY;
+
+    return mbedtls_ssl_tls13_crypto_backend_bind_transform(
+        transform,
+        ssl->conf->tls13_crypto_backend,
+        ssl->conf->p_tls13_crypto_backend,
+        mbedtls_ssl_get_tls13_crypto_backend_connection_data(ssl),
+        transform_data);
+}
+
+static void ssl_tls13_backend_free_transform_data_on_error(
+    mbedtls_ssl_context *ssl,
+    void *transform_data)
+{
+    const mbedtls_ssl_tls13_crypto_backend *backend;
+
+    if (ssl == NULL || ssl->conf == NULL || transform_data == NULL ||
+        ssl->conf->tls13_crypto_backend == NULL) {
+        return;
+    }
+
+    backend = ssl->conf->tls13_crypto_backend;
+    if (backend->transform_free != NULL) {
+        backend->transform_free(
+            ssl->conf->p_tls13_crypto_backend,
+            mbedtls_ssl_get_tls13_crypto_backend_connection_data(ssl),
+            transform_data);
+    }
+}
+
+static int ssl_tls13_backend_compute_shared_secret(
+    mbedtls_ssl_context *ssl,
+    unsigned char **shared_secret,
+    size_t *shared_secret_len)
+{
+#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)
+    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
+    mbedtls_ssl_handshake_params *handshake = ssl->handshake;
+
+    *shared_secret = NULL;
+    *shared_secret_len = 0;
+
+    if (!mbedtls_ssl_tls13_key_exchange_mode_with_ephemeral(ssl)) {
+        return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;
+    }
+
+    if (mbedtls_ssl_tls13_named_group_is_ecdhe(handshake->offered_group_id) ||
+        mbedtls_ssl_tls13_named_group_is_ffdh(handshake->offered_group_id)) {
+#if defined(PSA_WANT_ALG_ECDH) || defined(PSA_WANT_ALG_FFDH)
+        psa_algorithm_t alg =
+            mbedtls_ssl_tls13_named_group_is_ecdhe(handshake->offered_group_id) ?
+            PSA_ALG_ECDH : PSA_ALG_FFDH;
+        psa_status_t status = PSA_ERROR_GENERIC_ERROR;
+        psa_key_attributes_t key_attributes = PSA_KEY_ATTRIBUTES_INIT;
+
+        status = psa_get_key_attributes(handshake->xxdh_psa_privkey,
+                                        &key_attributes);
+        if (status != PSA_SUCCESS) {
+            return PSA_TO_MBEDTLS_ERR(status);
+        }
+
+        *shared_secret_len = PSA_BITS_TO_BYTES(
+            psa_get_key_bits(&key_attributes));
+        *shared_secret = mbedtls_calloc(1, *shared_secret_len);
+        if (*shared_secret == NULL) {
+            return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+        }
+
+        status = psa_raw_key_agreement(
+            alg, handshake->xxdh_psa_privkey,
+            handshake->xxdh_psa_peerkey, handshake->xxdh_psa_peerkey_len,
+            *shared_secret, *shared_secret_len, shared_secret_len);
+        if (status != PSA_SUCCESS) {
+            ret = PSA_TO_MBEDTLS_ERR(status);
+            MBEDTLS_SSL_DEBUG_RET(1, "psa_raw_key_agreement", ret);
+            goto cleanup;
+        }
+
+        status = psa_destroy_key(handshake->xxdh_psa_privkey);
+        if (status != PSA_SUCCESS) {
+            ret = PSA_TO_MBEDTLS_ERR(status);
+            MBEDTLS_SSL_DEBUG_RET(1, "psa_destroy_key", ret);
+            goto cleanup;
+        }
+        handshake->xxdh_psa_privkey = MBEDTLS_SVC_KEY_ID_INIT;
+        return 0;
+
+cleanup:
+        if (*shared_secret != NULL) {
+            mbedtls_zeroize_and_free(*shared_secret, *shared_secret_len);
+            *shared_secret = NULL;
+            *shared_secret_len = 0;
+        }
+        return ret;
+#else
+        return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;
+#endif
+    }
+
+    return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;
+#else
+    (void) ssl;
+    (void) shared_secret;
+    (void) shared_secret_len;
+    return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;
+#endif
+}
+
+static int ssl_tls13_generate_handshake_transform_backend(
+    mbedtls_ssl_context *ssl,
+    mbedtls_ssl_transform *transform)
+{
+    int ret;
+    mbedtls_md_type_t md_type;
+    unsigned char transcript[MBEDTLS_TLS1_3_MD_MAX_SIZE];
+    size_t transcript_len = 0;
+    unsigned char *shared_secret = NULL;
+    size_t shared_secret_len = 0;
+    void *transform_data = NULL;
+    const mbedtls_ssl_tls13_crypto_backend *backend =
+        ssl->conf->tls13_crypto_backend;
+
+    MBEDTLS_SSL_DEBUG_MSG(2, ("=> TLS 1.3 backend handshake key schedule"));
+
+    ret = ssl_tls13_backend_compute_shared_secret(ssl,
+                                                  &shared_secret,
+                                                  &shared_secret_len);
+    if (ret != 0) {
+        MBEDTLS_SSL_DEBUG_RET(1, "backend shared secret", ret);
+        goto cleanup;
+    }
+
+    md_type = (mbedtls_md_type_t) ssl->handshake->ciphersuite_info->mac;
+    ret = mbedtls_ssl_get_handshake_transcript(ssl, md_type,
+                                               transcript, sizeof(transcript),
+                                               &transcript_len);
+    if (ret != 0) {
+        MBEDTLS_SSL_DEBUG_RET(1,
+                              "mbedtls_ssl_get_handshake_transcript", ret);
+        goto cleanup;
+    }
+
+    ret = backend->handshake_keys(
+        ssl,
+        ssl->conf->p_tls13_crypto_backend,
+        mbedtls_ssl_get_tls13_crypto_backend_connection_data(ssl),
+        (uint16_t) ssl->handshake->ciphersuite_info->id,
+        (uint16_t) MBEDTLS_SSL_VERSION_TLS1_3,
+        shared_secret, shared_secret_len,
+        transcript, transcript_len,
+        &transform_data);
+    if (ret != 0) {
+        MBEDTLS_SSL_DEBUG_RET(1, "TLS 1.3 backend handshake keys", ret);
+        goto cleanup;
+    }
+
+    ret = ssl_tls13_backend_setup_external_transform(
+        ssl, transform, ssl->handshake->ciphersuite_info->id, transform_data);
+    if (ret != 0) {
+        MBEDTLS_SSL_DEBUG_RET(1, "TLS 1.3 backend handshake bind", ret);
+        ssl_tls13_backend_free_transform_data_on_error(ssl, transform_data);
+        transform_data = NULL;
+        goto cleanup;
+    }
+    transform_data = NULL;
+
+    MBEDTLS_SSL_DEBUG_MSG(2, ("<= TLS 1.3 backend handshake key schedule"));
+
+cleanup:
+    if (shared_secret != NULL) {
+        mbedtls_zeroize_and_free(shared_secret, shared_secret_len);
+    }
+    mbedtls_platform_zeroize(transcript, sizeof(transcript));
+    return ret;
+}
+
+static int ssl_tls13_generate_application_transform_backend(
+    mbedtls_ssl_context *ssl,
+    mbedtls_ssl_transform *transform)
+{
+    int ret;
+    mbedtls_md_type_t md_type;
+    unsigned char transcript[MBEDTLS_TLS1_3_MD_MAX_SIZE];
+    size_t transcript_len = 0;
+    void *transform_data = NULL;
+    const mbedtls_ssl_tls13_crypto_backend *backend =
+        ssl->conf->tls13_crypto_backend;
+
+    MBEDTLS_SSL_DEBUG_MSG(2, ("=> TLS 1.3 backend application key schedule"));
+
+    md_type = (mbedtls_md_type_t) ssl->handshake->ciphersuite_info->mac;
+    ret = mbedtls_ssl_get_handshake_transcript(ssl, md_type,
+                                               transcript, sizeof(transcript),
+                                               &transcript_len);
+    if (ret != 0) {
+        MBEDTLS_SSL_DEBUG_RET(1,
+                              "mbedtls_ssl_get_handshake_transcript", ret);
+        goto cleanup;
+    }
+
+    ret = backend->application_keys(
+        ssl,
+        ssl->conf->p_tls13_crypto_backend,
+        mbedtls_ssl_get_tls13_crypto_backend_connection_data(ssl),
+        (uint16_t) ssl->handshake->ciphersuite_info->id,
+        (uint16_t) MBEDTLS_SSL_VERSION_TLS1_3,
+        transcript, transcript_len,
+        &transform_data);
+    if (ret != 0) {
+        MBEDTLS_SSL_DEBUG_RET(1, "TLS 1.3 backend application keys", ret);
+        goto cleanup;
+    }
+
+    ret = ssl_tls13_backend_setup_external_transform(
+        ssl, transform, ssl->handshake->ciphersuite_info->id, transform_data);
+    if (ret != 0) {
+        MBEDTLS_SSL_DEBUG_RET(1, "TLS 1.3 backend application bind", ret);
+        ssl_tls13_backend_free_transform_data_on_error(ssl, transform_data);
+        transform_data = NULL;
+        goto cleanup;
+    }
+    transform_data = NULL;
+
+    MBEDTLS_SSL_DEBUG_MSG(2, ("<= TLS 1.3 backend application key schedule"));
+
+cleanup:
+    mbedtls_platform_zeroize(transcript, sizeof(transcript));
+    return ret;
+}
+#endif /* MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND */
+
 int mbedtls_ssl_tls13_compute_handshake_transform(mbedtls_ssl_context *ssl)
 {
     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
-    mbedtls_ssl_key_set traffic_keys;
+    mbedtls_ssl_key_set traffic_keys = { 0 };
     mbedtls_ssl_transform *transform_handshake = NULL;
     mbedtls_ssl_handshake_params *handshake = ssl->handshake;
 
+#if defined(MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND)
+    if (ssl_tls13_backend_has_capability(
+            ssl, MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_KEY_SCHEDULE) != 0) {
+        transform_handshake = mbedtls_calloc(1, sizeof(mbedtls_ssl_transform));
+        if (transform_handshake == NULL) {
+            ret = MBEDTLS_ERR_SSL_ALLOC_FAILED;
+            goto cleanup;
+        }
+
+        ret = ssl_tls13_generate_handshake_transform_backend(
+            ssl, transform_handshake);
+        if (ret != 0) {
+            MBEDTLS_SSL_DEBUG_RET(
+                1, "ssl_tls13_generate_handshake_transform_backend", ret);
+            goto cleanup;
+        }
+
+        handshake->transform_handshake = transform_handshake;
+        transform_handshake = NULL;
+        ret = 0;
+        goto cleanup;
+    }
+#endif /* MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND */
+
     /* Compute handshake secret */
     ret = ssl_tls13_key_schedule_stage_handshake(ssl);
     if (ret != 0) {
@@ -1849,9 +2193,34 @@ int mbedtls_ssl_tls13_compute_resumption_master_secret(mbedtls_ssl_context *ssl)
 int mbedtls_ssl_tls13_compute_application_transform(mbedtls_ssl_context *ssl)
 {
     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
-    mbedtls_ssl_key_set traffic_keys;
+    mbedtls_ssl_key_set traffic_keys = { 0 };
     mbedtls_ssl_transform *transform_application = NULL;
 
+#if defined(MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND)
+    if (ssl_tls13_backend_has_capability(
+            ssl, MBEDTLS_SSL_TLS1_3_CRYPTO_BACKEND_CAP_KEY_SCHEDULE) != 0) {
+        transform_application =
